{
    "name": "ipt10/jollibee-orders",
    "description": "Factory Method Design Pattern demo using a Jollibee-style food ordering system",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ipt10\\JollibeeOrders\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ipt10\\JollibeeOrders\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs"
    }
}
